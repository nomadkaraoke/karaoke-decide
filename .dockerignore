# Only pyproject.toml, poetry.lock, karaoke_decide/, backend/ and data/vocal_range/ go into the image.
# Keep host bytecode (often another Python version) and bulky dirs out of the build context.
**/__pycache__
**/*.py[cod]
.git
.github
.mypy_cache
.pytest_cache
.ruff_cache
.local-stack
.superpowers
.claude
frontend
docs
candidates
tests
infrastructure
scripts
*.md
!README.md
